{
  "name": "TáNaLista — Java, Go, Buf e Docker",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": true,
      "iptablesSwitchAtRuntime": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/.local/share/mise/shims"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "API e Swagger — mantenha a porta privada",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "5432": {
      "label": "PostgreSQL interno",
      "onAutoForward": "ignore"
    },
    "9090": {
      "label": "gRPC interno",
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "golang.go", "redhat.vscode-yaml"]
    }
  }
}
