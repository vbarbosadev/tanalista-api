# Build from the repository root; no host Maven, Java or pre-existing target.
FROM eclipse-temurin:21-jdk-alpine AS build
RUN apk add --no-cache unzip wget
WORKDIR /workspace
COPY api/ ./api/
COPY protos/ ./protos/
WORKDIR /workspace/api
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw && ./mvnw -B -DskipTests package

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache wget
WORKDIR /app
COPY --from=build /workspace/api/target/quarkus-app/ ./
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -Dquarkus.http.host=0.0.0.0"
USER 10001
EXPOSE 8081
HEALTHCHECK --interval=5s --timeout=3s --start-period=30s --retries=20 \
  CMD wget -q -O /dev/null http://127.0.0.1:8081/q/health/ready || exit 1
ENTRYPOINT ["java", "-jar", "/app/quarkus-run.jar"]
