# Somente desenvolvimento local; substitua credenciais antes de qualquer deploy.
DB_NAME=tanalista
DB_USER=tanalista
DB_PASSWORD=troque-esta-senha-local
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/tanalista
# Sem autenticacao: habilite apenas em ambiente local/confiavel.
DEV_IDENTITY_ENABLED=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Opcional: consulta externa; identidade acima continua somente local.
# Host/porta abaixo sao usados quando a API roda fora do Compose.
BARCODE_GRPC_HOST=localhost
BARCODE_GRPC_PORT=9090
BARCODE_TIMEOUT_MS=2500
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT=2s
OFF_USER_AGENT=TaNaLista/1.0 (https://github.com/vbarbosadev/tanalista-api)
